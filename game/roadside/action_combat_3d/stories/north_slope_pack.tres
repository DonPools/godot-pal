[gd_resource type="Resource" script_class="NorthSlopePackStory" load_steps=7 format=3]

[ext_resource type="Script" path="res://game/roadside/action_combat_3d/stories/north_slope_pack.gd" id="1_story"]
[ext_resource type="Resource" path="res://game/roadside/action_combat_3d/stories/north_slope_pack_dialogue.tres" id="2_dialogue"]
[ext_resource type="Resource" path="res://content/encounters/north_slope_pack.tres" id="3_encounter"]
[ext_resource type="Resource" path="res://content/items/wound_powder.tres" id="4_item"]
[ext_resource type="Script" path="res://framework/content/map_destination.gd" id="5_destination"]

[sub_resource type="Resource" id="MapDestination_defeat"]
script = ExtResource("5_destination")
map_id = &"map.roadside.north_slope_wilds"
spawn_id = &"default"

[resource]
script = ExtResource("1_story")
id = &"story.roadside.north_slope_pack"
initial_stage = &"not_started"
valid_stages = Array[StringName]([&"not_started", &"cleared"])
dialogue = ExtResource("2_dialogue")
encounter = ExtResource("3_encounter")
supply_item = ExtResource("4_item")
defeat_destination = SubResource("MapDestination_defeat")
