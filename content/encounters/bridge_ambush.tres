[gd_resource type="Resource" script_class="BattleEncounter" load_steps=4 format=3]

[ext_resource type="Script" path="res://framework/content/battle_encounter.gd" id="1_encounter"]
[ext_resource type="Script" path="res://framework/content/encounter_enemy.gd" id="2_enemy_entry"]
[ext_resource type="Resource" path="res://content/enemies/bridge_bandit.tres" id="3_bandit"]

[sub_resource type="Resource" id="EncounterEnemy_bandit"]
script = ExtResource("2_enemy_entry")
enemy = ExtResource("3_bandit")
instance_id = &"bandit_leader"

[resource]
script = ExtResource("1_encounter")
id = &"encounter.lab.bridge_ambush"
display_name = "断桥伏击"
description = "验证剧情战斗结果提交边界的单敌遭遇。"
tags = Array[StringName]([&"framework_lab", &"story_battle"])
enemies = Array[ExtResource("2_enemy_entry")]([SubResource("EncounterEnemy_bandit")])
allows_escape = true
