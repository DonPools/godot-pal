[gd_resource type="Resource" script_class="DialogueDefinition" load_steps=28 format=3]

[ext_resource type="Script" path="res://game/dialogue/dialogue_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://game/dialogue/dialogue_block.gd" id="2_block"]
[ext_resource type="Script" path="res://game/dialogue/dialogue_entry.gd" id="3_entry"]

[sub_resource type="Resource" id="Entry_opening_1"]
script = ExtResource("3_entry")
speaker = "逍遙"
text = "昨夜的雨，竟還沒有停。"
portrait_source_id = 1

[sub_resource type="Resource" id="Entry_opening_2"]
script = ExtResource("3_entry")
speaker = "掌櫃"
text = "醒啦？前廳有件小事等著你。"
portrait_source_id = 55

[sub_resource type="Resource" id="Block_opening"]
script = ExtResource("2_block")
id = &"opening"
entries = Array[ExtResource("3_entry")]([SubResource("Entry_opening_1"), SubResource("Entry_opening_2")])

[sub_resource type="Resource" id="Entry_request_1"]
script = ExtResource("3_entry")
speaker = "掌櫃"
text = "雨院井邊留著一把舊傘。"
portrait_source_id = 55

[sub_resource type="Resource" id="Entry_request_2"]
script = ExtResource("3_entry")
speaker = "掌櫃"
text = "問問那位蓑衣客，可是他的。"
portrait_source_id = 55

[sub_resource type="Resource" id="Block_request"]
script = ExtResource("2_block")
id = &"innkeeper_request"
entries = Array[ExtResource("3_entry")]([SubResource("Entry_request_1"), SubResource("Entry_request_2")])

[sub_resource type="Resource" id="Entry_reminder"]
script = ExtResource("3_entry")
speaker = "掌櫃"
text = "蓑衣客正在雨院避雨。"
portrait_source_id = 55

[sub_resource type="Resource" id="Block_reminder"]
script = ExtResource("2_block")
id = &"innkeeper_reminder"
entries = Array[ExtResource("3_entry")]([SubResource("Entry_reminder")])

[sub_resource type="Resource" id="Entry_waiting"]
script = ExtResource("3_entry")
speaker = "掌櫃"
text = "既是他的，便把井邊舊傘取來。"
portrait_source_id = 55

[sub_resource type="Resource" id="Block_waiting"]
script = ExtResource("2_block")
id = &"innkeeper_waiting"
entries = Array[ExtResource("3_entry")]([SubResource("Entry_waiting")])

[sub_resource type="Resource" id="Entry_finish_1"]
script = ExtResource("3_entry")
speaker = "逍遙"
text = "舊傘找到了，傘骨還很牢。"
portrait_source_id = 1

[sub_resource type="Resource" id="Entry_finish_2"]
script = ExtResource("3_entry")
speaker = "掌櫃"
text = "好。雨停前，讓它留在門邊吧。"
portrait_source_id = 55

[sub_resource type="Resource" id="Block_finish"]
script = ExtResource("2_block")
id = &"innkeeper_finish"
entries = Array[ExtResource("3_entry")]([SubResource("Entry_finish_1"), SubResource("Entry_finish_2")])

[sub_resource type="Resource" id="Entry_complete"]
script = ExtResource("3_entry")
speaker = "掌櫃"
text = "今日總算沒讓客人淋雨。"
portrait_source_id = 55

[sub_resource type="Resource" id="Block_complete"]
script = ExtResource("2_block")
id = &"innkeeper_complete"
entries = Array[ExtResource("3_entry")]([SubResource("Entry_complete")])

[sub_resource type="Resource" id="Entry_guest"]
script = ExtResource("3_entry")
speaker = "住客"
text = "這雨聲，倒很適合喝一壺茶。"
portrait_source_id = 3

[sub_resource type="Resource" id="Block_guest"]
script = ExtResource("2_block")
id = &"quiet_guest"
entries = Array[ExtResource("3_entry")]([SubResource("Entry_guest")])

[sub_resource type="Resource" id="Entry_courtyard"]
script = ExtResource("3_entry")
speaker = "逍遙"
text = "雨院潮得很，那人就在井旁。"
portrait_source_id = 1

[sub_resource type="Resource" id="Block_courtyard"]
script = ExtResource("2_block")
id = &"courtyard_first"
entries = Array[ExtResource("3_entry")]([SubResource("Entry_courtyard")])

[sub_resource type="Resource" id="Entry_before"]
script = ExtResource("3_entry")
speaker = "蓑衣客"
text = "小兄弟，雨天路滑，慢些走。"
portrait_source_id = 59

[sub_resource type="Resource" id="Block_before"]
script = ExtResource("2_block")
id = &"traveler_before"
entries = Array[ExtResource("3_entry")]([SubResource("Entry_before")])

[sub_resource type="Resource" id="Entry_reveal_1"]
script = ExtResource("3_entry")
speaker = "蓑衣客"
text = "那把舊傘正是我的。"
portrait_source_id = 59

[sub_resource type="Resource" id="Entry_reveal_2"]
script = ExtResource("3_entry")
speaker = "蓑衣客"
text = "手裡行囊太多，勞你代取。"
portrait_source_id = 59

[sub_resource type="Resource" id="Block_reveal"]
script = ExtResource("2_block")
id = &"traveler_reveal"
entries = Array[ExtResource("3_entry")]([SubResource("Entry_reveal_1"), SubResource("Entry_reveal_2")])

[sub_resource type="Resource" id="Entry_repeat"]
script = ExtResource("3_entry")
speaker = "蓑衣客"
text = "舊傘就在井沿旁。"
portrait_source_id = 59

[sub_resource type="Resource" id="Block_repeat"]
script = ExtResource("2_block")
id = &"traveler_repeat"
entries = Array[ExtResource("3_entry")]([SubResource("Entry_repeat")])

[sub_resource type="Resource" id="Entry_thanks"]
script = ExtResource("3_entry")
speaker = "蓑衣客"
text = "有勞了。待雨小些，我便啟程。"
portrait_source_id = 59

[sub_resource type="Resource" id="Block_thanks"]
script = ExtResource("2_block")
id = &"traveler_thanks"
entries = Array[ExtResource("3_entry")]([SubResource("Entry_thanks")])

[sub_resource type="Resource" id="Entry_locked"]
script = ExtResource("3_entry")
speaker = "逍遙"
text = "一把舊傘。還是先問清主人吧。"
portrait_source_id = 1

[sub_resource type="Resource" id="Block_locked"]
script = ExtResource("2_block")
id = &"umbrella_locked"
entries = Array[ExtResource("3_entry")]([SubResource("Entry_locked")])

[sub_resource type="Resource" id="Entry_take"]
script = ExtResource("3_entry")
speaker = "逍遙"
text = "找到了。帶回前廳交給掌櫃。"
portrait_source_id = 1

[sub_resource type="Resource" id="Block_take"]
script = ExtResource("2_block")
id = &"umbrella_take"
entries = Array[ExtResource("3_entry")]([SubResource("Entry_take")])

